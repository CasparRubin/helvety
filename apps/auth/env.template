# =============================================================================
# Helvety Auth - Vercel project: helvety-auth
# Vercel Root Directory: apps/auth
# =============================================================================
# Copy this file to .env.local and fill in your values.
# App URLs & cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here # Server-only. Keep secret and never expose to clients.

# --- Upstash Redis (rate limiting) --------------------------------------------
# Get from: https://console.upstash.com/ > Redis > REST API
# Required by startup validation in all environments.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# --- Cookie signing (server-only) --------------------------------------------
# Generate with: openssl rand -base64 48
# Required in dev/prod (min 32 chars). Signs CSRF cookies in the proxy; re-issues invalid/stale cookies.
# Dedicated secret only — do not reuse SUPABASE_SECRET_KEY.
HELVETY_COOKIE_SIGNING_SECRET=

# --- Device trust cookie signing -----------------------------------------------
# Generate with: openssl rand -base64 48
# Required in dev/prod (min 32 chars). Signs helvety_device_trust (passkey-first
# return sign-in on /auth/login after email verification; auth zone only).
DEVICE_TRUST_COOKIE_SECRET=

# --- Vercel Analytics (optional) ----------------------------------------------
# NEXT_PUBLIC_HELVETY_VERCEL_ANALYTICS=false
#   Skips HelvetyVercelAnalytics in shared root layouts (@helvety/ui). Useful for local dev without the gateway proxy.
# Production (helvety.com): enable Web Analytics on THIS Vercel project and redeploy so /<id>/script.js is served.
#   The gateway (helvety-com) forwards that script URL to this deployment based on the page Referer.

# --- Optional (monorepo / CI) -------------------------------------------------
# SKIP_ENV_VALIDATION=1
#   Local build smoke tests only (off Vercel). ci:release uses real validation.
# HELVETY_SERVER_ACTION_ALLOWED_ORIGINS=https://helvety.com,https://your-preview.vercel.app
#   Override Server Actions allowed origins (comma-separated). On Vercel, defaults
#   are derived from deployment URLs plus https://helvety.com.
