# =============================================================================
# Helvety Auth - Vercel project: helvety-auth
# Vercel Root Directory: apps/auth
# =============================================================================
# Copy this file to .env.local and fill in your values.
# App URLs & cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API (publishable key sb_publishable_* only; not JWT anon keys)
# Email OTP expiry (Authentication → Email) should match user-facing copy (1 hour;
# see OTP_USER_VISIBLE_EXPIRY_LABEL in apps/auth/lib/otp-code.ts and emails/*.html).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here # Server-only. Keep secret and never expose to clients.

# --- Upstash Redis (rate limiting + extension passkey single-use challenges) -
# Get from: https://console.upstash.com/ > Redis > REST API
# Required by startup validation in all environments.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# --- Cookie signing (server-only) --------------------------------------------
# Generate with: openssl rand -base64 48
# Required in dev/prod (min 32 chars). Signs CSRF cookies in the proxy; re-issues invalid/stale cookies.
# Dedicated secret only — do not reuse SUPABASE_SECRET_KEY.
HELVETY_COOKIE_SIGNING_SECRET=

# --- Device trust cookie signing -----------------------------------------------
# Generate with: openssl rand -base64 48
# Required in dev/prod (min 32 chars). Signs helvety_device_trust. Minted on the
# auth zone after email verification; E2EE/docs zones verify the same secret value.
DEVICE_TRUST_COOKIE_SECRET=

# --- Chrome extension auth API (server-only allowlist) -------------------------
# Comma-separated Chromium extension ids (Chrome, Edge, Brave), e.g. from
# edge://extensions/?id=<id> or chrome://extensions. Full chrome-extension://
# URLs are also accepted (legacy). Extension OTP and passkey APIs reject other IDs.
HELVETY_CHROME_EXTENSION_ORIGINS=your-32-char-extension-id-here

# --- Optional (monorepo / CI) -------------------------------------------------
# SKIP_ENV_VALIDATION=1
#   Local build smoke tests only (off Vercel). ci:release uses real validation.
# HELVETY_SERVER_ACTION_ALLOWED_ORIGINS=https://helvety.com,https://your-preview.vercel.app
#   Override Server Actions allowed origins (comma-separated). On Vercel, defaults
#   are derived from deployment URLs plus https://helvety.com.
