# =============================================================================
# Helvety Links - Vercel project: helvety-links
# =============================================================================
# Copy this file to .env.local and fill in your values.
# App URLs & cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# --- Upstash Redis (rate limiting) --------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# --- Cookie signing (server-only) --------------------------------------------
# Generate with: openssl rand -base64 48
# Required in dev/prod (min 32 chars). Signs CSRF cookies in proxy bootstrap.
# Dedicated secret only — do not reuse SUPABASE_SECRET_KEY.
HELVETY_COOKIE_SIGNING_SECRET=
