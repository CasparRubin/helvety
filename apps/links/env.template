# =============================================================================
# Helvety Links - Vercel project: helvety-links
# Vercel Root Directory: apps/links
# =============================================================================
# Copy this file to .env.local and fill in your values.
# App URLs & cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API (publishable key sb_publishable_* only; not JWT anon keys)
# No SUPABASE_SECRET_KEY — vault CRUD uses the user-scoped client + RLS only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Upstash Redis (rate limiting) --------------------------------------------
# Get from: https://console.upstash.com/ > Redis > REST API
# Required by startup validation in all environments.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# --- Cookie signing (server-only) --------------------------------------------
# Generate with: openssl rand -base64 48
# Required in dev/prod (min 32 chars). Signs CSRF cookies in the proxy; re-issues invalid/stale cookies.
# Dedicated secret only — do not reuse SUPABASE_SECRET_KEY.
HELVETY_COOKIE_SIGNING_SECRET=

# --- Device trust (server-only) --------------------------------------------
# Same value as helvety-auth. Verifies weekly device-trust cookie for API access.
# Generate with: openssl rand -base64 48
DEVICE_TRUST_COOKIE_SECRET=

# --- Optional (monorepo / CI) -------------------------------------------------
# SKIP_ENV_VALIDATION=1
#   Local build smoke tests only (off Vercel). ci:release uses real validation.
# HELVETY_SERVER_ACTION_ALLOWED_ORIGINS=https://helvety.com,https://your-preview.vercel.app
#   Override Server Actions allowed origins (comma-separated). On Vercel, defaults
#   are derived from deployment URLs plus https://helvety.com.
