{
  "name": "@helvety/links",
  "version": "3.8.0",
  "description": "Encrypted bookmarks in nested folders under an All library root, with client-side search. Swiss-built.",
  "author": "Helvety",
  "homepage": "https://helvety.com/links",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "apps/links"
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node ../../scripts/generate-version.mjs && next dev -p 3009",
    "build": "node ../../scripts/generate-version.mjs && next build",
    "start": "next start -p 3009",
    "lint": "node ../../scripts/generate-version.mjs && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "node ../../scripts/generate-version.mjs && bunx next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@helvety/brand": "workspace:*",
    "@helvety/shared": "workspace:*",
    "@helvety/ui": "workspace:*",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@helvety/config": "workspace:*",
    "@helvety/dev-deps": "workspace:*"
  }
}
