# =============================================================================
# Helvety Store — Vercel project: helvety-store
# =============================================================================
# Copy to .env.local and fill in your values.
# App URLs & cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here          # Server-only! Must not be exposed.

# --- Stripe -------------------------------------------------------------------
# Get from: Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here   # Server-only! Must not be exposed.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Webhook secret — Stripe Dashboard > Developers > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here    # Server-only! Must not be exposed.

# Stripe Price IDs — Stripe Dashboard > Product catalog > Prices
# Used by the SPO Explorer checkout tiers.
STRIPE_HELVETY_SPO_EXPLORER_SOLO_MONTHLY_PRICE_ID=price_your_solo_monthly_price_id
STRIPE_HELVETY_SPO_EXPLORER_SUPPORTED_MONTHLY_PRICE_ID=price_your_supported_monthly_price_id

# --- License validation (optional) ---------------------------------------------
# Optional shared secret for signed machine-to-machine license validation calls.
# Do NOT use this for browser/SPFx direct calls (the secret would be exposed).
# Leave unset unless you operate a trusted server-side caller that signs requests.
# LICENSE_VALIDATION_SHARED_SECRET=replace-with-a-long-random-shared-secret-at-least-32-chars

# --- Upstash Redis (rate limiting) --------------------------------------------
# Get from: https://console.upstash.com/ > Redis > REST API
# Required by startup validation in all environments.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here
