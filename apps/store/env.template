# =============================================================================
# Helvety Store — Vercel project: helvety-store
# =============================================================================
# Copy to .env.local and fill in your values.
# App URLs & cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-secret-key-here       # Server-only! Recommended: sb_secret_... (legacy service_role may exist in older setups). Must not be exposed.

# --- Upstash Redis (rate limiting) --------------------------------------------
# Get from: https://console.upstash.com/ > Redis > REST API
# Required by startup validation in all environments.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here
