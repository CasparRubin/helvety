{
  "name": "@helvety/image-editor",
  "version": "3.6.0",
  "description": "In-browser image editor for annotations: text, arrows, borders, spotlight highlights, blur regions, and crop with adjustable corners, plus layers, property controls, zoom, and PNG/JPEG export. WebP input supported. No server upload, no account required. Engineered, designed and made in Switzerland.",
  "author": "Helvety",
  "homepage": "https://helvety.com/image-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "apps/image-editor"
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node ../../scripts/generate-version.mjs && next dev -p 3010",
    "build": "node ../../scripts/generate-version.mjs && next build",
    "start": "next start -p 3010",
    "lint": "node ../../scripts/generate-version.mjs && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "node ../../scripts/generate-version.mjs && bunx next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@helvety/brand": "workspace:*",
    "@helvety/shared": "workspace:*",
    "@helvety/ui": "workspace:*",
    "canvas-size": "^2.0.0",
    "konva": "^10.2.0",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@helvety/config": "workspace:*",
    "@helvety/dev-deps": "workspace:*"
  }
}
