# =============================================================================
# Helvety PDF - Vercel project: helvety-pdf
# =============================================================================
# Copy this file to .env.local and fill in your values.
# App URLs & cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
# No SUPABASE_SECRET_KEY or Upstash vars — no server admin client or rate limiting;
# only public Supabase (session/bootstrap) plus CSRF cookie signing below.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Cookie signing (server-only) --------------------------------------------
# Generate with: openssl rand -base64 48
# Required in dev/prod (min 32 chars). Signs CSRF cookies in the proxy; re-issues invalid/stale cookies.
# Dedicated secret only — do not reuse SUPABASE_SECRET_KEY.
HELVETY_COOKIE_SIGNING_SECRET=

# --- Optional (monorepo / CI) -------------------------------------------------
# SKIP_ENV_VALIDATION=1
#   Local build smoke tests only (off Vercel). ci:release uses real validation.
# HELVETY_SERVER_ACTION_ALLOWED_ORIGINS=https://helvety.com,https://your-preview.vercel.app
#   Override Server Actions allowed origins (comma-separated). On Vercel, defaults
#   are derived from deployment URLs plus https://helvety.com.
