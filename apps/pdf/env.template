# =============================================================================
# Helvety PDF — Vercel project: helvety-pdf
# =============================================================================
# Copy to .env.local and fill in your values.
# App URLs & cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Experimental PDF processing pipeline ------------------------------------
# Feature flags for staged rollout of worker/GPU processing.
# Keep GPU OFF by default in production until benchmark acceptance criteria pass.
NEXT_PUBLIC_PDF_WORKER_PIPELINE=true
NEXT_PUBLIC_PDF_GPU_PIPELINE=false
NEXT_PUBLIC_PDF_PIPELINE_TELEMETRY=false
