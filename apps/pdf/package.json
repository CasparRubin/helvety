{
  "name": "@helvety/pdf",
  "version": "3.1.0",
  "description": "In-browser PDF merge, reorder, rotate, and extract; supported work stays local. MIT-licensed toolkit from Switzerland.",
  "author": "Helvety",
  "homepage": "https://helvety.com/pdf",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "apps/pdf"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "bun run sync:pdf-worker && node ../../scripts/generate-version.mjs && next dev -p 3004",
    "build": "bun run sync:pdf-worker && node ../../scripts/generate-version.mjs && next build",
    "start": "next start -p 3004",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sync:pdf-worker": "node ./scripts/sync-pdf-worker.mjs"
  },
  "dependencies": {
    "@helvety/brand": "workspace:*",
    "@helvety/shared": "workspace:*",
    "@helvety/ui": "workspace:*",
    "@supabase/supabase-js": "^2.105.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-pdf": "^10.4.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@helvety/config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "jsdom": "29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "pdfjs-dist": "^5.7.284",
    "node-domexception": "^2.0.2"
  }
}
