{
  "name": "@helvety/pdf",
  "version": "3.0.0",
  "description": "Privacy-focused, client-side PDF toolkit for merging, reordering, rotating, and extracting pages. Engineered & Designed in Switzerland.",
  "author": "Helvety by Rubin",
  "homepage": "https://helvety.com/pdf",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "apps/pdf"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node ../../scripts/generate-version.mjs && next dev -p 3004",
    "build": "node ../../scripts/generate-version.mjs && next build",
    "start": "next start -p 3004",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node -e \"const fs=require('fs');const path=require('path');const reactPdfDir=path.dirname(require.resolve('react-pdf/package.json'));const pdfjsPkg=require.resolve('pdfjs-dist/package.json',{paths:[reactPdfDir]});const src=path.join(path.dirname(pdfjsPkg),'build','pdf.worker.min.mjs');const dst=path.join(process.cwd(),'public','pdf.worker.min.mjs');fs.mkdirSync(path.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);\""
  },
  "dependencies": {
    "@helvety/brand": "workspace:*",
    "@helvety/shared": "workspace:*",
    "@helvety/ui": "workspace:*",
    "@supabase/supabase-js": "^2.98.0",
    "lucide-react": "^0.576.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-pdf": "^10.4.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@helvety/config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.3",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "pdfjs-dist": "^5.5.207",
    "node-domexception": "^2.0.2"
  }
}
