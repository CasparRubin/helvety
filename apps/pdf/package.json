{
  "name": "@helvety/pdf",
  "version": "3.8.0",
  "description": "In-browser PDF merge, reorder, rotate, extract, and add images; supported work stays local. Swiss-built toolkit.",
  "author": "Helvety",
  "homepage": "https://helvety.com/pdf",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "apps/pdf"
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "bun run sync:pdf-worker && node ../../scripts/generate-version.mjs && next dev -p 3003",
    "build": "bun run sync:pdf-worker && node ../../scripts/generate-version.mjs && next build",
    "start": "next start -p 3003",
    "lint": "node ../../scripts/generate-version.mjs && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "node ../../scripts/generate-version.mjs && bunx next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sync:pdf-worker": "node ./scripts/sync-pdf-worker.mjs"
  },
  "dependencies": {
    "@helvety/brand": "workspace:*",
    "@helvety/shared": "workspace:*",
    "@helvety/ui": "workspace:*",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.4.1"
  },
  "devDependencies": {
    "@helvety/config": "workspace:*",
    "@helvety/dev-deps": "workspace:*"
  },
  "overrides": {
    "node-domexception": "^2.0.2"
  }
}
