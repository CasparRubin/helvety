# =============================================================================
# Helvety Web (Gateway) - Vercel project: helvety-web
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Public app URL/cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).
# Internal gateway rewrite targets are configured below via AUTH_URL/STORE_URL/... in production.

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Gateway rewrite URLs (Vercel production only) ----------------------------
# The Web app rewrites /auth, /store, /pdf, /image-upscaler, /tasks, /contacts, /notes, /links (and
# /auth-static, /tasks-static, /contacts-static, /notes-static, /links-static for sub-app assets) to each sub-app's
# internal Vercel deployment URL. It also forwards Vercel Analytics /<id>/script.js to the zone deployment
# indicated by Referer (including ?query and #hash after the zone path, e.g. /links?link=). Each sub-zone
# project must have Web Analytics enabled so its deployment serves that script.
# Not needed locally (falls back to localhost).
# Sub-app deployments also redirect direct-domain root (/) to their app basePath.
AUTH_URL=https://helvety-auth.vercel.app
STORE_URL=https://helvety-store.vercel.app
PDF_URL=https://helvety-pdf.vercel.app
IMAGE_UPSCALER_URL=https://helvety-image-upscaler.vercel.app
TASKS_URL=https://helvety-tasks.vercel.app
CONTACTS_URL=https://helvety-contacts.vercel.app
NOTES_URL=https://helvety-notes.vercel.app
LINKS_URL=https://helvety-links.vercel.app

# --- Vercel Analytics (optional) ----------------------------------------------
# NEXT_PUBLIC_HELVETY_VERCEL_ANALYTICS=false
#   Skips HelvetyVercelAnalytics / Speed Insights in the gateway shell (@helvety/ui).
# Production: enable Web Analytics on helvety-web AND on every sub-zone project above, then redeploy each.

# --- Optional (monorepo / CI) -------------------------------------------------
# SKIP_ENV_VALIDATION=1
#   Local build smoke tests only (off Vercel). ci:release uses real validation.
# HELVETY_SERVER_ACTION_ALLOWED_ORIGINS=https://helvety.com,https://your-preview.vercel.app
#   Override Server Actions allowed origins (comma-separated). On Vercel, defaults
#   are derived from deployment URLs plus https://helvety.com.
