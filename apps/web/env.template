# =============================================================================
# Helvety Web (Gateway) - Vercel project: helvety-com
# Vercel Root Directory: apps/web
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Public app URLs are derived from NODE_ENV (see packages/shared/src/config.ts).
# Internal gateway rewrite targets are configured below via STORE_URL/... in production.
# Gateway tier intentionally omits UPSTASH_REDIS_* (store owns Upstash for downloads).

# --- Gateway rewrite URLs (Vercel production only) ----------------------------
# The Web app rewrites /store, /pdf, /image-editor, /ocr to each sub-app's
# internal Vercel deployment URL.
# Not needed locally (falls back to localhost).
# Sub-app deployments also redirect direct-domain root (/) to their app basePath.
STORE_URL=https://helvety-store.vercel.app
PDF_URL=https://helvety-pdf.vercel.app
IMAGE_EDITOR_URL=https://helvety-image-editor.vercel.app
OCR_URL=https://helvety-ocr.vercel.app

# --- Optional (monorepo / CI) -------------------------------------------------
# SKIP_ENV_VALIDATION=1
#   Local build smoke tests only (off Vercel). ci:release uses real validation.
# HELVETY_SERVER_ACTION_ALLOWED_ORIGINS=https://helvety.com,https://your-preview.vercel.app
#   Override Server Actions allowed origins (comma-separated). On Vercel, defaults
#   are derived from deployment URLs plus https://helvety.com.
