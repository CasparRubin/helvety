# =============================================================================
# Helvety Web (Gateway) — Vercel project: helvety-web
# =============================================================================
# Copy to .env.local and fill in your values.
# Public app URL/cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).
# Internal gateway rewrite targets are configured below via AUTH_URL/STORE_URL/... in production.

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Gateway rewrite URLs (Vercel production only) ----------------------------
# The Web app rewrites /auth, /store, /pdf, /tasks, /contacts to each sub-app's
# internal Vercel deployment URL. Not needed locally (falls back to localhost).
AUTH_URL=https://helvety-auth.vercel.app
STORE_URL=https://helvety-store.vercel.app
PDF_URL=https://helvety-pdf.vercel.app
TASKS_URL=https://helvety-tasks.vercel.app
CONTACTS_URL=https://helvety-contacts.vercel.app

# Optional comma-separated allowlist for trusted rewrite hosts in production.
# If unset, internal *.vercel.app and *.helvety.com defaults are used.
# Example: helvety-auth.vercel.app,helvety-store.vercel.app
INTERNAL_APP_HOST_ALLOWLIST=

# --- Build --------------------------------------------------------------------
# Optional: set to true to enable @next/bundle-analyzer during build.
ANALYZE=false
