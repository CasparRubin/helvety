# =============================================================================
# Helvety Web (Gateway) — Vercel project: helvety-web
# =============================================================================
# Copy to .env.local and fill in your values.
# Public app URL/cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).
# Internal gateway rewrite targets are configured below via AUTH_URL/STORE_URL/... in production.

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Gateway rewrite URLs (Vercel production only) ----------------------------
# The Web app rewrites /auth, /store, /pdf, /tasks, /contacts (and
# /tasks-static, /contacts-static for sub-app assets) to each sub-app's
# internal Vercel deployment URL. Not needed locally (falls back to localhost).
AUTH_URL=https://helvety-auth.vercel.app
STORE_URL=https://helvety-store.vercel.app
PDF_URL=https://helvety-pdf.vercel.app
TASKS_URL=https://helvety-tasks.vercel.app
CONTACTS_URL=https://helvety-contacts.vercel.app
