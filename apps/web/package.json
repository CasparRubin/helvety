{
  "name": "@helvety/web",
  "version": "3.2.0",
  "description": "Gateway application that routes to helvety.com Next.js zones in this monorepo. Public marketing, legal, and SEO surfaces. Engineered, Designed & Made in Switzerland.",
  "author": "Helvety",
  "homepage": "https://helvety.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "apps/web"
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node ../../scripts/generate-version.mjs && next dev -p 3001",
    "build": "node ../../scripts/generate-version.mjs && next build",
    "start": "next start -p 3001",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@helvety/brand": "workspace:*",
    "@helvety/light-pillar": "workspace:*",
    "@helvety/shared": "workspace:*",
    "@helvety/ui": "workspace:*",
    "framer-motion": "^12.39.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "postprocessing": "^6.39.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@helvety/config": "workspace:*",
    "@helvety/dev-deps": "workspace:*",
    "@types/three": "0.184.1"
  }
}
