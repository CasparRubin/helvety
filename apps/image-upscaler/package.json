{
  "name": "@helvety/image-upscaler",
  "version": "3.2.0",
  "description": "In-browser image upscaler with on-device AI when supported and a quality resize fallback. 2×/4× or target dimensions, batches up to five files, no server upload, no account required. Swiss-built.",
  "author": "Helvety",
  "homepage": "https://helvety.com/image-upscaler",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "apps/image-upscaler"
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node ../../scripts/copy-ort-runtime.mjs",
    "prebuild": "node ../../scripts/copy-ort-runtime.mjs",
    "dev": "node ../../scripts/generate-version.mjs && next dev -p 3008",
    "build": "node ../../scripts/generate-version.mjs && next build",
    "start": "next start -p 3008",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@helvety/brand": "workspace:*",
    "@helvety/shared": "workspace:*",
    "@helvety/ui": "workspace:*",
    "canvas-size": "^2.0.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@helvety/config": "workspace:*",
    "@helvety/dev-deps": "workspace:*"
  }
}
