{
  "name": "@helvety/image-upscaler",
  "version": "3.1.0",
  "description": "In-browser image upscaler with on-device AI (Real-ESRGAN via onnxruntime-web, WebGPU with WASM fallback) and a canvas-resample fallback: 2×/4× or target dimensions, per-image and batch flows, no server-side image processing, no account required. MIT-licensed, Swiss-built.",
  "author": "Helvety",
  "homepage": "https://helvety.com/image-upscaler",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "apps/image-upscaler"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node ../../scripts/copy-ort-runtime.mjs",
    "prebuild": "node ../../scripts/copy-ort-runtime.mjs",
    "dev": "node ../../scripts/generate-version.mjs && next dev -p 3008",
    "build": "node ../../scripts/generate-version.mjs && next build",
    "start": "next start -p 3008",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@helvety/brand": "workspace:*",
    "@helvety/shared": "workspace:*",
    "@helvety/ui": "workspace:*",
    "@supabase/supabase-js": "^2.105.1",
    "canvas-size": "^2.0.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "onnxruntime-web": "^1.25.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@helvety/config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "jsdom": "29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
