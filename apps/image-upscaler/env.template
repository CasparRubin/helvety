# =============================================================================
# Helvety Image Upscaler — Vercel project: helvety-image-upscaler
# =============================================================================
# Copy this file to .env.local and fill in your values.
# App URLs & cookie domain are derived from NODE_ENV (see packages/shared/src/config.ts).

# --- Supabase ----------------------------------------------------------------
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Cookie signing (server-only) --------------------------------------------
# Required in environments where proxy bootstrap signs CSRF/session cookies.
# If omitted, requests that touch signing flows can fail with HTTP 500.
HELVETY_COOKIE_SIGNING_SECRET=replace-with-a-long-random-secret
