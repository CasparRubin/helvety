{
  "name": "@helvety/brand",
  "version": "0.1.0",
  "private": true,
  "description": "Shared brand assets: SVG React components and asset URL constants",
  "author": "Helvety",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://helvety.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "packages/brand"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "exports": {
    ".": "./src/index.ts",
    "./logo": "./src/logo.tsx",
    "./identifier": "./src/identifier.tsx",
    "./urls": "./src/urls.ts"
  },
  "dependencies": {
    "@helvety/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@helvety/config": "workspace:*",
    "@helvety/dev-deps": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
