{
  "name": "@helvety/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript, ESLint (createEslintConfig / createPackageEslintConfig + @typescript-eslint/naming-convention; default export for package self-lint), Vitest, PostCSS, and Next.js security-header configurations",
  "author": "Helvety",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://helvety.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "packages/config"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "type-check": "echo \"No TypeScript sources in @helvety/config\"",
    "lint": "eslint --config eslint.mjs . --max-warnings 0",
    "lint:fix": "eslint --config eslint.mjs . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.extension.json": "./tsconfig.extension.json",
    "./eslint": "./eslint.mjs",
    "./vitest": "./vitest.mjs",
    "./vitest-extension": {
      "types": "./vitest-extension.d.ts",
      "default": "./vitest-extension.mjs"
    },
    "./vitest.setup": "./vitest.setup.shared.ts",
    "./postcss": "./postcss.mjs",
    "./next-headers": "./next-headers.mjs",
    "./next": "./next.mjs"
  },
  "peerDependencies": {
    "eslint": "^10.7.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.11",
    "next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "github:jsx-eslint/eslint-plugin-react#c9a2de775bdc704d3be416193cb28db0017c7f8b",
    "eslint-plugin-jsdoc": "^63.2.0",
    "typescript-eslint": "^8.65.0",
    "@vitejs/plugin-react": "^6"
  },
  "devDependencies": {
    "@helvety/dev-deps": "workspace:*"
  }
}
