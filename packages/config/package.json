{
  "name": "@helvety/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript, ESLint (createEslintConfig / createPackageEslintConfig + @typescript-eslint/naming-convention; default export for package self-lint), Vitest, PostCSS, and Next.js security-header configurations",
  "author": "Helvety",
  "license": "MIT",
  "homepage": "https://helvety.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "packages/config"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "type-check": "echo \"No TypeScript sources in @helvety/config\"",
    "lint": "eslint --config eslint.mjs . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint": "./eslint.mjs",
    "./vitest": "./vitest.mjs",
    "./postcss": "./postcss.mjs",
    "./next-headers": "./next-headers.mjs",
    "./next": "./next.mjs"
  },
  "peerDependencies": {
    "eslint": "^9.39.4",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "typescript-eslint": "^8.59.1",
    "@vitejs/plugin-react": "^5.2.0"
  }
}
