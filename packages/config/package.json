{
  "name": "@helvety/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, Vitest, PostCSS, and Next.js security-header configurations",
  "author": "Helvety by Rubin",
  "license": "MIT",
  "homepage": "https://helvety.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git",
    "directory": "packages/config"
  },
  "scripts": {
    "type-check": "echo \"No TypeScript sources in @helvety/config\"",
    "lint": "eslint --config eslint.mjs . --max-warnings 0",
    "test": "echo \"No tests in @helvety/config\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint": "./eslint.mjs",
    "./vitest": "./vitest.mjs",
    "./postcss": "./postcss.mjs",
    "./next-headers": "./next-headers.mjs"
  },
  "peerDependencies": {
    "eslint": "^9.39.3",
    "vitest": "^4"
  },
  "dependencies": {
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^62.7.1",
    "typescript-eslint": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4"
  }
}
