{
  "extends": "@helvety/config/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/ui": ["./src"],
      "@/ui/*": ["./src/*"],
      "@helvety/ui/*": ["./src/*"],
      "@helvety/shared/utils": ["../shared/src/utils.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules"]
}
