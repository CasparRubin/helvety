{
  "name": "helvety",
  "version": "2.25.0",
  "private": true,
  "description": "Monorepo for all Helvety applications. Engineered, Designed & Made in Switzerland.",
  "author": "Helvety",
  "license": "MIT",
  "homepage": "https://helvety.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CasparRubin/helvety.git"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:check": "bun run format:check && bun run lint && bun run type-check && bun run test",
    "ci:release": "bun run format:check && bun run lint && bun run type-check && bun run test && bun run build",
    "ci:release:stub": "bun run format:check && bun run lint && bun run type-check && bun run test && SKIP_ENV_VALIDATION=1 bun run build",
    "deps:audit": "bun audit",
    "deps:security:floors": "node scripts/check-security-dependency-floors.mjs",
    "deps:security": "bun run deps:security:floors && bun run deps:audit",
    "deps:outdated": "bun outdated",
    "deps:check": "knip --no-progress --include files,dependencies",
    "knip:exports": "knip --no-progress --include exports,types",
    "deps:unused": "bun run deps:check && bun run knip:exports",
    "db:gen-types": "bunx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > packages/shared/src/types/database.types.ts"
  },
  "overrides": {
    "rollup": "4.59.0",
    "minimatch": "10.2.4",
    "ajv": "6.14.0",
    "hono": "4.12.14",
    "@hono/node-server": "1.19.13",
    "vite": "7.3.2",
    "express-rate-limit": "8.2.2",
    "undici": "7.24.0",
    "flatted": "3.4.2",
    "yaml": "2.8.3",
    "brace-expansion": "5.0.5",
    "path-to-regexp": "8.4.0",
    "picomatch": "2.3.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "knip": "^6.6.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "turbo": "^2.9.6"
  }
}
