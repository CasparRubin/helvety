{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{mjs,js}"],
      "project": ["scripts/**/*.{mjs,js}"],
      "ignoreDependencies": ["onnxruntime-web"]
    },
    "apps/*": {
      "entry": [
        "app/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "{instrumentation,proxy}.{ts,tsx,js,mjs,cjs}",
        "next.config.{ts,js,mjs,cjs}",
        "vitest.config.{ts,js,mjs,cjs}"
      ],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"]
    },
    "packages/*": {
      "entry": [
        "src/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "*.{ts,tsx,js,jsx,mjs,cjs}"
      ],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"]
    },
    "packages/config": {
      "entry": ["*.{ts,tsx,js,jsx,mjs,cjs}"],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "ignoreBinaries": ["vitest"]
    }
  },
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "prettier-plugin-tailwindcss",
    "shadcn",
    "tailwindcss"
  ],
  "ignore": ["apps/pdf/public/pdf.worker.min.mjs"],
  "ignoreIssues": {
    "packages/shared/src/types/database.types.ts": [
      "exports",
      "types",
      "nsExports",
      "nsTypes"
    ]
  }
}
