{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{mjs,js}", "e2e/**/*.{ts,tsx}"],
      "project": ["scripts/**/*.{mjs,js}", "e2e/**/*.{ts,tsx}"]
    },
    "packages/dev-deps": {
      "entry": [],
      "project": [],
      "ignoreDependencies": [
        "@tailwindcss/postcss",
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@types/react",
        "@types/react-dom",
        "@vitest/coverage-v8",
        "babel-plugin-react-compiler",
        "eslint",
        "fake-indexeddb",
        "jsdom",
        "prettier",
        "prettier-plugin-tailwindcss",
        "shadcn",
        "tailwindcss",
        "vitest"
      ]
    },
    "apps/*": {
      "entry": [
        "app/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "{instrumentation,proxy}.{ts,tsx,js,mjs,cjs}",
        "next.config.{ts,js,mjs,cjs}",
        "eslint.config.mjs",
        "vitest.config.{ts,js,mjs,cjs}",
        "vitest.setup.ts",
        "**/*.{test,spec}.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "ignoreDependencies": ["@helvety/dev-deps"]
    },
    "packages/*": {
      "entry": [
        "src/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "*.{ts,tsx,js,jsx,mjs,cjs}",
        "eslint.config.mjs",
        "vitest.config.{ts,js,mjs,cjs}",
        "**/*.{test,spec}.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "ignoreDependencies": ["@helvety/dev-deps"]
    },
    "packages/config": {
      "entry": ["*.{ts,tsx,js,jsx,mjs,cjs}"],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "ignoreDependencies": ["@helvety/dev-deps", "eslint-plugin-react"]
    },
    "packages/ui": {
      "entry": [
        "src/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "*.{ts,tsx,js,jsx,mjs,cjs}",
        "eslint.config.mjs",
        "vitest.config.{ts,js,mjs,cjs}",
        "**/*.{test,spec}.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "ignoreDependencies": ["@helvety/dev-deps", "@tailwindcss/postcss"]
    },
    "packages/extension-chrome": {
      "entry": [
        "src/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "*.{ts,tsx,js,jsx,mjs,cjs}",
        "eslint.config.mjs",
        "vitest.config.{ts,js,mjs,cjs}",
        "**/*.{test,spec}.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "ignoreDependencies": ["@helvety/dev-deps", "@types/chrome"]
    }
  },
  "ignoreDependencies": ["@helvety/dev-deps"],
  "ignore": [
    "apps/pdf/public/pdf.worker.min.mjs",
    "apps/pdf/lib/empty-canvas-stub.mjs",
    "apps/ocr/public/pdf.worker.min.mjs",
    "apps/ocr/lib/empty-canvas-stub.mjs",
    "apps/image-editor/vitest.browser-mocks.ts",
    "apps/*/lib/utils.ts"
  ],
  "ignoreIssues": {
    "apps/image-editor/vitest.konva-mock.ts": ["exports"],
    "packages/shared/src/types/database.types.ts": [
      "exports",
      "types",
      "nsExports",
      "nsTypes"
    ],
    "packages/shared/src/env-validation.ts": ["duplicates"]
  }
}
