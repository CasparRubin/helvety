{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "HELVETY_COOKIE_SIGNING_SECRET",
        "DEVICE_TRUST_COOKIE_SECRET",
        "AUTH_URL",
        "TASKS_URL",
        "CONTACTS_URL",
        "NOTES_URL",
        "LINKS_URL",
        "STORE_URL",
        "PDF_URL",
        "DOCS_URL",
        "IMAGE_UPSCALER_URL",
        "HELVETY_SERVER_ACTION_ALLOWED_ORIGINS",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "NEXT_PUBLIC_HELVETY_VERCEL_ANALYTICS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {},
    "test": {}
  },
  "globalEnv": ["NODE_ENV", "SKIP_ENV_VALIDATION", "VERCEL"]
}
