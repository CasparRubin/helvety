{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {},
    "test": {}
  },
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SECRET_KEY",
    "AUTH_URL",
    "TASKS_URL",
    "CONTACTS_URL",
    "NOTES_URL",
    "STORE_URL",
    "PDF_URL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "NEXT_PUBLIC_PDF_WORKER_PIPELINE",
    "NEXT_PUBLIC_PDF_GPU_PIPELINE",
    "NEXT_PUBLIC_PDF_PIPELINE_TELEMETRY"
  ]
}
